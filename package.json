{
  "name": "ludo-backend",
  "version": "1.0.0",
  "description": "Strategic Ludo Game Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node --dns-result-order=ipv4first src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:unit",
    "test:unit": "jest --testPathIgnorePatterns=__tests__/integration",
    "test:integration": "jest --runInBand --testMatch \"**/__tests__/integration/**/*.test.js\"",
    "test:integration:local": "powershell -ExecutionPolicy Bypass -File ./scripts/test-integration-local.ps1",
    "migrate": "knex --knexfile knexfile.js --env development migrate:latest",
    "migrate:test": "knex --knexfile knexfile.js --env test migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js --env development migrate:rollback"
  },
  "keywords": [
    "ludo",
    "game",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "pg": "^8.19.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "type": "commonjs"
}
